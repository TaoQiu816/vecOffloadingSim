#!/usr/bin/env python
"""
使用项目的evaluate_baselines.py为当前运行评估baseline
"""

import sys
import os
from pathlib import Path

# 添加项目根目录到路径
project_root = Path(__file__).parent.parent.parent
sys.path.insert(0, str(project_root))

import json
from scripts.evaluate_baselines import run_baseline_evaluation

def main():
    run_dir = Path(__file__).parent
    
    # 加载配置
    with open(run_dir / 'config.json', 'r') as f:
        config_dict = json.load(f)
    
    # 提取关键配置参数
    scene_config = {
        'NUM_VEHICLES': config_dict.get('NUM_VEHICLES', 20),
        'NUM_RSU': config_dict.get('NUM_RSU', 2),
        'SEED': config_dict.get('SEED', 42),
        'MAX_STEPS': config_dict.get('MAX_STEPS', 300),
        'TRUST_ENABLED': config_dict.get('TRUST_ENABLED', True),
        'MALICIOUS_RATIO': config_dict.get('MALICIOUS_RATIO', 0.0),
    }
    
    print("=" * 80)
    print("Baseline评估配置")
    print("=" * 80)
    for key, value in scene_config.items():
        print(f"  {key}: {value}")
    print()
    
    # 运行baseline评估
    output_dir = run_dir / 'baseline_results'
    output_dir.mkdir(exist_ok=True)
    
    print("=" * 80)
    print("开始Baseline评估 (100 episodes per baseline)")
    print("=" * 80)
    print()
    
    results = run_baseline_evaluation(
        scene_config=scene_config,
        output_dir=str(output_dir),
        num_episodes=100,
        seed=42
    )
    
    # 保存结果
    import pandas as pd
    summary_df = pd.DataFrame(results).T
    summary_file = output_dir / 'baseline_summary.csv'
    summary_df.to_csv(summary_file)
    
    print("\n" + "=" * 80)
    print("Baseline评估完成!")
    print("=" * 80)
    print(f"结果保存在: {output_dir}")
    print()
    
    # 显示结果
    print("Baseline性能汇总:")
    print(summary_df.to_string())
    
    return results

if __name__ == '__main__':
    results = main()
