# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
ENV/
env/

# 训练输出
# runs 下默认同步训练结果；仅忽略测试/临时产物
!runs/.gitkeep
/logs/
# 非核心/临时仿真产物（不同步）
runs/tmp*
runs/test*
runs/accept_*
runs/smoke*
runs/reg*
runs/quick_train_patch_check/
runs/exp_contract_demo/

# 模型文件（较大，不同步）
models/*.pth
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.bin
runs/**/*.pth
runs/**/checkpoints/
.cursor/
.claude/
.cursorrules

# 评估/审计输出（非训练必需）
audit_results/
eval_results/
sweep_results/
out/

# 审计脚本（测试/调试用，不同步）
scripts/audit/*
scripts/test_*.py

# 数据文件
data/
#*.csv
*.jsonl
#*.json

# 图表
#plots/
#*.png
#*.jpg
#*.pdf

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# TensorBoard
tensorboard/
events.out.tfevents.*

# Jupyter
.ipynb_checkpoints/
*.ipynb

# 临时文件
tmp/
temp/
*.tmp
*.log

# 测试覆盖率
.coverage
htmlcov/
.pytest_cache/

# 文档构建
docs/_build/
docs/build/

# 忽略所有目录下的 step_log.csv 文件
**/step_log.csv

# Claude生成的审查报告（不同步到git）
docs/claude-reports/

# 测试（不同步到git）
tests/

# 文档（不同步到git）
docs/
notes/
