# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
.venv/
venv/
ENV/
env/

# 训练输出
# runs 下默认同步全部产物
!runs/.gitkeep
/logs/

# 模型文件（较大，不同步）
models/*.pth
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.bin
.cursor/
.claude/
.cursorrules

# 评估/审计输出（非训练必需）
audit_results/
eval_results/
sweep_results/
out/

# 审计脚本（测试/调试用，不同步）
scripts/audit/*
scripts/test_*.py

# 数据文件
data/
#*.csv
*.jsonl
#*.json

# 图表
#plots/
#*.png
#*.jpg
#*.pdf

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store

# TensorBoard
tensorboard/
events.out.tfevents.*

# Jupyter
.ipynb_checkpoints/
*.ipynb

# 临时文件
tmp/
temp/
*.tmp
*.log

# 测试覆盖率
.coverage
htmlcov/
.pytest_cache/

# 文档构建
docs/_build/
docs/build/

# 忽略所有目录下的 step_log.csv 文件
**/step_log.csv

# Claude生成的审查报告（不同步到git）
docs/claude-reports/

# 测试（不同步到git）
tests/

# 文档（不同步到git）
docs/
notes/

# runs 全同步；训练模型仅保留 best/last 两个文件
!runs/**
runs/**/models/*.pth
!runs/**/models/best_model.pth
!runs/**/models/last_model.pth
**/audit_results/

# 分析和清理文档（不同步到git）
REWARD_*.md
SIMULATION_*.md
LEGACY_*.md
FINAL_*.md
*_CLEANUP_*.md
*_FIX_*.md
*_AUDIT_*.md
*_VERIFICATION_*.md
*_ANALYSIS_*.md
PROJECT_CLEANUP_*.md

# 诊断/计划目录（不同步到git）
diagnostics/
plans/

# 非仿真所需脚本（诊断/分析/验证类，不同步到git）
scripts/run_authoritative_eval.py
scripts/run_formal_checkpoint_eval.py
scripts/run_baseline_consistency_eval.py
scripts/smoke_test_terminated_reason.py
scripts/run_rprog_alignment_validation.py
scripts/run_short_train_validation.py
