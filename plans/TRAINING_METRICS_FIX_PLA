### 方案D：添加数据完整性校���（必须）

**新增文件**：`scripts/verify_training_metrics.py`

```python
#!/usr/bin/env python3
"""
训练指标完整性校验脚本

用法：
    python scripts/verify_training_metrics.py --csv runs/run_*/logs/training_stats.csv
"""
import pandas as pd
import numpy as np
import argparse
import sys

def verify_metrics(csv_path):
    """验证训练指标的完整性和一致性"""
    df = pd.read_csv(csv_path)
    
    errors = []
    warnings = []
    
    # 检查1：成功率 > 0 但 task_duration_mean = 0
    mask1 = (df['task_sr'] > 0.01) & (df['task_duration_mean'] < 0.001)
    if mask1.any():
        bad_episodes = df[mask1]['episode'].tolist()
        errors.append(
            f"Episodes {bad_episodes} have task_sr > 1% but task_duration_mean ≈ 0. "
            f"This indicates task completion time is not being recorded."
        )
    
    # 检查2：有决策步数但 energy_mean = 0
    if 'decision_steps' in df.columns:
        mask2 = (df['decision_steps'] > 0) & (df['energy_mean'] < 1e-9)
        if mask2.any():
            bad_episodes = df[mask2]['episode'].tolist()
            warnings.append(
                f"Episodes {bad_episodes} have decision_steps > 0 but energy_mean ≈ 0. "
                f"This may indicate energy is not being recorded."
            )
    
    # 检查3：completed_tasks 与 task_sr 不一致
    if 'completed_tasks' in df.columns and 'episode_vehicle_count' in df.columns:
        expected_completed = (df['task_sr'] * df['episode_vehicle_count']).round()
        actual_completed = df['completed_tasks']
        mask3 = (expected_completed > 0) & (actual_completed == 0)
        if mask3.any():
            bad_episodes = df[mask3]['episode'].tolist()
            errors.append(
                f"Episodes {bad_episodes} have expected completed tasks > 0 "
                f"but completed_tasks = 0. This indicates a data collection bug."
            )
    
    # 检查4：必需字段是否存在
    required_fields = [
        'episode', 'reward_mean', 'task_sr', 'vehicle_sr', 'subtask_sr',
        'task_duration_mean', 'energy_mean', 'decision_frac_local',
        'decision_frac_rsu', 'decision_frac_v2v', 'actor_loss', 'critic_loss'
    ]
    missing_fields = [f for f in required_fields if f not in df.columns]
    if missing_fields:
        errors.append(f"Missing required fields: {missing_fields}")
    
    # 输出结果
    print(f"\n{'='*80}")
    print(f"Training Metrics Verification Report")
    print(f"{'='*80}")
    print(f"CSV: {csv_path}")
    print(f"Total Episodes: {len(df)}")
    print(f"{'='*80}\n")
    
    if errors:
        print(f"❌ ERRORS ({len(errors)}):")
        for i, err in enumerate(errors, 1):
            print(f"  {i}. {err}")
        print()
    
    if warnings:
        print(f"⚠️  WARNINGS ({len(warnings)}):")
        for i, warn in enumerate(warnings, 1):
            print(f"  {i}. {warn}")
        print()
    
    if not errors and not warnings:
        print("✅ All checks passed! Training metrics are complete and consistent.")
    
    return len(errors) == 0

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Verify training metrics completeness")
    parser.add_argument("--csv", required=True, help="Path to training_stats.csv")
    args = parser.parse_args()
    
    success = verify_metrics(args.csv)
    sys.exit(0 if success else 1)
```

