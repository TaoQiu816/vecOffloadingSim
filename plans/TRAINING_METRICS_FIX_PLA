```

**修复代码**：
```python
# 【修��】确保所有已完成任务都被统计
if not self._episode_task_durations:
    # 如果列表为空，但有任务完成，从vehicles重新收集
    for v in self.vehicles:
        if v.task_dag.is_finished and not v.task_dag.is_failed:
            if v.task_dag.completion_time is not None and v.task_dag.completion_time > 0:
                # 检查是否已记录（避免重复）
                if not getattr(v.task_dag, "_completion_logged", False):
                    self._episode_task_durations.append(v.task_dag.completion_time)
                    v.task_dag._completion_logged = True

if self._episode_task_durations:
    episode_metrics['task_duration_mean'] = float(np.mean(self._episode_task_durations))
    episode_metrics['task_duration_p95'] = float(np.percentile(self._episode_task_durations, 95))
    episode_metrics['completed_tasks_count'] = len(self._episode_task_durations)
else:
    # 【修复】如果仍然为空，但success_rate > 0，记录警告
    if episode_metrics.get('task_success_rate', 0.0) > 0.01:
        print(
            f"[WARNING] Episode has {episode_metrics['task_success_rate']*100:.1f}% success rate "
            f"but no task durations recorded. This indicates a data collection bug.",
            flush=True
        )
    episode_metrics['task_duration_mean'] = 0.0
    episode_metrics['task_duration_p95'] = 0.0
    episode_metrics['completed_tasks_count'] = 0
```

